# Image for the lightweight Kafka-consumer workers: rules_extractor and
# es_indexer. No Playwright, no docling — just Python + kafka + db + S3 +
# OpenAI-compatible client + Elasticsearch client.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
        "boto3>=1.34.0" \
        "kafka-python>=2.0.2" \
        "psycopg2-binary>=2.9.9" \
        "python-dotenv>=1.0.0" \
        "tenacity>=8.2.3" \
        "openai>=1.50.0" \
        "elasticsearch>=8.13.0,<9.0.0"

COPY config.py rules_extractor.py es_indexer.py ./
COPY rules_common/  ./rules_common/
COPY rules_generator/ ./rules_generator/

# Override per service: `python rules_extractor.py` or `python es_indexer.py`.
CMD ["python", "rules_extractor.py"]
