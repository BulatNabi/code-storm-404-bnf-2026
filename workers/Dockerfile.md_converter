FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/cache/huggingface

# docling needs poppler for PDF rendering; libgl/glib for image ops in transformers.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        poppler-utils \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Light deps first — fast layer, separate from the heavy ML install below.
RUN pip install --no-cache-dir \
        "boto3>=1.34.0" \
        "kafka-python>=2.0.2" \
        "psycopg2-binary>=2.9.9" \
        "python-dotenv>=1.0.0" \
        "tenacity>=8.2.3"

# CPU-only torch keeps the image manageable (~250MB vs ~3GB with CUDA).
# Done in a separate layer so the Docker daemon doesn't OOM during resolution.
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch torchvision

# docling on top of the existing CPU torch.
RUN pip install --no-cache-dir "docling>=2.0.0"

COPY config.py md_converter.py ./

CMD ["python", "md_converter.py"]
